# Normaliza finales de línea: LF en el repo, nativo en cada máquina.
# Sin esto, un Mac y un Windows se pisan el archivo entero en cada commit.
* text=auto eol=lf

*.md   text eol=lf
*.html text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.json text eol=lf

# Binarios: sin conversión.
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
*.xlsx binary
*.docx binary
*.mpp  binary
