# ---- Datos sensibles de la validación ----
# Respuestas de estudiantes y exportaciones con datos personales.
# Ley N.o 29733 de Protección de Datos Personales.
datos-validacion/
*.sav
respuestas_*.xlsx
respuestas_*.csv

# ---- Caché de herramientas locales ----
.impeccable/

# ---- Código generado ----
# El cliente de Prisma se genera al instalar (pnpm install) a partir de apps/api/prisma/schema.prisma.
apps/api/src/generado/
apps/api/.bd-local/

# ---- Pruebas de punta a punta ----
apps/web/test-results/
apps/web/playwright-report/

# ---- Entrenamiento de los modelos ----
# El entorno de Python y el conjunto sintético se regeneran con la semilla (packages/modelos/entrenamiento).
packages/modelos/entrenamiento/.venv/
packages/modelos/entrenamiento/datos/
__pycache__/
