# Variables de docker compose (compose.yaml). El .env de esta carpeta no se escribe a mano:
# `node herramientas/docker/crear-entorno.mjs` lo crea a partir de este archivo, con las claves al azar.
# Git y las imágenes lo ignoran. Nunca lo subas al repositorio.

# Claves de PostgreSQL: la del dueño de la base, que corre las migraciones, y la de riego_app, con la que entra la
# API. Solo letras, números, - y _, porque van dentro de la dirección de la base.
CLAVE_BD=
CLAVE_RIEGO_APP=

# Al menos 32 caracteres al azar.
JWT_SECRETO=

# Dominio del correo institucional y códigos de curso, separados por comas.
DOMINIO_CORREO=undac.edu.pe
CODIGOS_CURSO=

# Correo de contacto que se declara a OpenStreetMap en cada pedido de teselas (lo exige su política de uso).
CONTACTO_OSM=

# Puerto de la máquina donde queda la web. ORIGEN_WEB tiene que coincidir con él.
PUERTO_WEB=8080
ORIGEN_WEB=http://localhost:8080

# «si» carga el banco de ejemplo cuando la base no tiene uno. Sus ítems son de muestra: para el estudio va «no» y
# se carga el banco aprobado.
CARGAR_BANCO_DE_EJEMPLO=si

# Opcionales. Sin definir valen lo que se indica, que es lo de desarrollo; se cambian sin tocar el código.
# Proxies delante de la API (Railway y nginx ponen uno): de ahí sale la IP del cliente para los límites.
# SALTOS_DE_PROXY=1
# Conexiones a PostgreSQL que abre la API. No pases del tope del plan de la base.
# CONEXIONES_BD=10
# Días que vale una respuesta guardada de clima, suelo y elevación.
# VIGENCIA_CACHE_DIAS=365
# Límites. Un laboratorio entero sale por una sola IP: súbelos si la sección es grande.
# LIMITE_REGISTROS_POR_IP=200        cuentas nuevas por IP cada 15 minutos
# LIMITE_INTENTOS_DE_SESION=10       intentos fallidos por correo cada 15 minutos
# LIMITE_TESELAS_POR_MINUTO=3000     teselas del mapa por IP cada minuto
# Nivel del registro técnico (Pino): fatal, error, warn, info, debug o trace.
# NIVEL_REGISTRO=info
