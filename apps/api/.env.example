# Copia este archivo como .env (git lo ignora) y completa los valores. Nunca subas el .env al repositorio.

# PostgreSQL. En local, por ejemplo: postgresql://riego:riego@localhost:5432/riego
# En el despliegue, DATABASE_URL entra como riego_app (prisma/rol-de-la-aplicacion.sql) y URL_MIGRACIONES como el
# dueño de la base, que es quien corre las migraciones. En local basta con DATABASE_URL.
DATABASE_URL=
URL_MIGRACIONES=

# Dominio del correo institucional (se aceptan sus subdominios) y códigos de curso, separados por comas.
DOMINIO_CORREO=undac.edu.pe
CODIGOS_CURSO=

# Al menos 32 caracteres al azar. Por ejemplo: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRETO=

# Origen de la aplicación web.
ORIGEN_WEB=http://localhost:5173

# Correo de contacto que se declara a OpenStreetMap en cada pedido de teselas (lo exige su política de uso).
CONTACTO_OSM=

# «si» cuando la web y la API están en sitios distintos (onrender.com y up.railway.app); «no» con un dominio propio.
COOKIE_ENTRE_SITIOS=no

# Swagger UI en /api/docs. Sin definir, se abre en desarrollo y se cierra en producción.
# DOCUMENTACION_PUBLICA=

# Solo para exportar el registro. Guárdalo aparte: con el mismo secreto, dos exportaciones dan los mismos códigos.
SECRETO_SEUDONIMO=

# Opcionales. Sin definir valen lo que se indica, que es lo de desarrollo; se cambian sin tocar el código.
# Proxies delante de la API (Railway y nginx ponen uno): de ahí sale la IP del cliente para los límites.
# SALTOS_DE_PROXY=1
# Conexiones a PostgreSQL que abre la API. No pases del tope del plan de la base.
# CONEXIONES_BD=10
# Días que vale una respuesta guardada de clima, suelo y elevación.
# VIGENCIA_CACHE_DIAS=365
# Límites. Un laboratorio entero sale por una sola IP: súbelos si la sección es grande.
# LIMITE_REGISTROS_POR_IP=200        cuentas nuevas por IP cada 15 minutos
# LIMITE_INTENTOS_DE_SESION=10       intentos fallidos por correo cada 15 minutos
# LIMITE_TESELAS_POR_MINUTO=3000     teselas del mapa por IP cada minuto
# Nivel del registro técnico (Pino): fatal, error, warn, info, debug o trace.
# NIVEL_REGISTRO=info
